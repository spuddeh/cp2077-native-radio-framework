+    std::snprintf(line, sizeof line,
+                  "probe first id=%u maxFrames=%u chan=0x%x stateIn=%u voice=%s", aPlayingId, reqMax, reqChan,
+                  stateIn, self->Find(aPlayingId) ? "found" : "none");
+    ProbeLog(line);
+  } else {
+    const uint64_t dt = now - pr.lastQpc;
+    pr.minDt = std::min(pr.minDt, dt);
+    pr.maxDt = std::max(pr.maxDt, dt);
+    pr.sumDt += dt;
+    ++pr.winDt;
+    if (reqMax != pr.lastMax || reqChan != pr.lastChan) {
+      std::snprintf(line, sizeof line, "probe change id=%u call=%llu maxFrames %u->%u chan 0x%x->0x%x", aPlayingId,
+                    static_cast<unsigned long long>(pr.calls), pr.lastMax, reqMax, pr.lastChan, reqChan);
+      ProbeLog(line);
