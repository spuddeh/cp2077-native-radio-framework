+                  static_cast<unsigned long long>(ToUs(pr.minDt)),
+                  static_cast<unsigned long long>(n ? ToUs(pr.sumDt / n) : 0),
+                  static_cast<unsigned long long>(ToUs(pr.maxDt)), pr.minMax, pr.maxMax, reqChan,
+                  static_cast<unsigned long long>(pr.produced), static_cast<unsigned long long>(pr.shortCalls),
+                  static_cast<unsigned long long>(pr.notReady), row, pos);
+    ProbeLog(line);
+    pr.minDt = ~0ull;
+    pr.maxDt = 0;
+    pr.sumDt = 0;
+    pr.winDt = 0;
+    pr.minMax = 0xFFFF;
+    pr.maxMax = 0;
+  }
+}
