+  }
+  pr.lastQpc = now;
+  pr.lastMax = reqMax;
+  pr.lastChan = reqChan;
+  pr.minMax = std::min(pr.minMax, reqMax);
+  pr.maxMax = std::max(pr.maxMax, reqMax);
+  ++pr.calls;
+
+  ExecuteInner(aPlayingId, aBuffer);
+
+  // PROBE: capture the result.
+  const uint16_t valid = buf->uValidFrames;
+  const uint32_t stateOut = buf->eState;
+  pr.produced += valid;
+  const bool isShort = valid < reqMax;
+  const bool notReady = stateOut != kDataReady;
+  if (isShort) ++pr.shortCalls;
+  if (notReady) ++pr.notReady;
+  if ((isShort || notReady) && (pr.shortLogged < 20 || (pr.shortLogged % 100) == 0)) {
+    std::snprintf(line, sizeof line, "probe short id=%u call=%llu valid=%u max=%u stateOut=%u", aPlayingId,
+                  static_cast<unsigned long long>(pr.calls), valid, reqMax, stateOut);
+    ProbeLog(line);
+  }
+  if (isShort || notReady) ++pr.shortLogged;
+  pr.lastState = stateOut;
+  if (pr.calls % kProbeEvery == 0) {
+    const uint64_t n = pr.winDt;
+    double pos = -1.0;
+    uint16_t row = 0xFFFF;
+    if (Voice* pv = self->Find(aPlayingId)) {
+      pos = pv->pos;
+      row = pv->row;
+    }
+    std::snprintf(line, sizeof line,
+                  "probe sum id=%u calls=%llu t=%llums dt_us min/avg/max=%llu/%llu/%llu maxFrames=%u..%u chan=0x%x "
+                  "produced=%llu short=%llu notReady=%llu row=%u pos=%.0f",
+                  aPlayingId, static_cast<unsigned long long>(pr.calls),
