+// ---- PROBE (measurement build, not for release) ----------------------------------------------
+// One record per playing id. Records how the engine pulls from the feed: call interval, frames
+// requested, channel config and state. A line is written on the first call for an id, on any change
+// of the requested frame count or channel config, on a short or non-ready result (rate-limited), and
+// as a summary every kProbeEvery calls.
+struct Probe {
+  uint32_t playingId = 0;
+  uint64_t calls = 0;
+  uint64_t firstQpc = 0;
+  uint64_t lastQpc = 0;
+  uint64_t minDt = ~0ull;
+  uint64_t maxDt = 0;
+  uint64_t sumDt = 0;
+  uint64_t winDt = 0;
+  uint16_t lastMax = 0;
+  uint16_t minMax = 0xFFFF;
+  uint16_t maxMax = 0;
+  uint32_t lastChan = 0;
+  uint32_t lastState = 0;
+  uint64_t shortCalls = 0;
+  uint64_t notReady = 0;
+  uint64_t produced = 0;
+  uint64_t shortLogged = 0;
+  double lastPos = 0.0;
+};
+constexpr size_t kProbes = 8;
+constexpr uint64_t kProbeEvery = 250;
+Probe g_probes[kProbes];
+uint64_t g_qpcFreq = 0;
+
+uint64_t Qpc() {
+  LARGE_INTEGER li;
+  QueryPerformanceCounter(&li);
+  return static_cast<uint64_t>(li.QuadPart);
+}
+
+uint64_t ToUs(uint64_t aTicks) {
+  if (g_qpcFreq == 0) {
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    g_qpcFreq = static_cast<uint64_t>(f.QuadPart);
+  }
+  return aTicks * 1000000ull / g_qpcFreq;
+}
+
+Probe& ProbeFor(uint32_t aPlayingId) {
+  Probe* oldest = &g_probes[0];
+  for (auto& p : g_probes) {
+    if (p.playingId == aPlayingId) return p;
+    if (p.playingId == 0) {
+      oldest = &p;
+      break;
+    }
+    if (p.lastQpc < oldest->lastQpc) oldest = &p;
+  }
+  *oldest = Probe{};
+  oldest->playingId = aPlayingId;
+  return *oldest;
+}
+
+void ProbeLog(const char* aLine) {
+  AudioXLPlugin::Get()->Info(aLine);
+}
+// ---- end PROBE -------------------------------------------------------------------------------
